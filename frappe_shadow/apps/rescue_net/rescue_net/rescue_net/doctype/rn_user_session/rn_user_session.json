{
  "doctype": "DocType",
  "name": "RN User Session",
  "module": "Rescue Net",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "field:legacy_id",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "fields": [
    { "fieldname": "legacy_id", "label": "Legacy ID", "fieldtype": "Data", "unique": 1 },
    { "fieldname": "legacy_source", "label": "Legacy Source", "fieldtype": "Data", "default": "rescue-net-fastapi" },
    { "fieldname": "migration_status", "label": "Migration Status", "fieldtype": "Select", "options": "Shadow Imported\nValidated\nNeeds Review", "default": "Shadow Imported" },
    { "fieldname": "title", "label": "Session Title", "fieldtype": "Data", "reqd": 1 },
    { "fieldname": "user", "label": "User Account", "fieldtype": "Link", "options": "RN User Account" },
    { "fieldname": "user_legacy_id", "label": "User Legacy ID", "fieldtype": "Data" },
    { "fieldname": "status", "label": "Status", "fieldtype": "Data" },
    { "fieldname": "session_token_fingerprint", "label": "Session Token Fingerprint (SHA-256, non-reversible)", "fieldtype": "Data" },
    { "fieldname": "expires_at", "label": "Expires At", "fieldtype": "Data" },
    { "fieldname": "legacy_payload", "label": "Legacy Payload (token redacted)", "fieldtype": "Code", "options": "JSON" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 0, "cancel": 0, "amend": 0 }
  ]
}
