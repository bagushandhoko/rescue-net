      "options": "Shadow Imported\nValidated\nNeeds Review"
    },
    {
      "fieldname": "title",
      "label": "Need Title",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "source_report",
      "label": "Source Community Report",
      "fieldtype": "Link",
      "options": "RN Community Report",
      "reqd": 1
    },
    {
      "fieldname": "requester_user",
      "label": "Requester",
      "fieldtype": "Link",
      "options": "RN User Account"
    },
    {
      "fieldname": "community_owner",
      "label": "Kelompok Masyarakat",
      "fieldtype": "Link",
      "options": "RN Organization"
    },
    {
      "fieldname": "disaster_event",
      "label": "Disaster Event",
      "fieldtype": "Link",
      "options": "RN Disaster Event"
    },
    {
      "fieldname": "need_type",
      "label": "Need Type",
      "fieldtype": "Data"
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "quantity",
      "label": "Quantity",
      "fieldtype": "Float"
    },
    {
      "fieldname": "unit",
      "label": "Unit",
      "fieldtype": "Data"
    },
    {
      "fieldname": "urgency",
      "label": "Urgency",
      "fieldtype": "Select",
      "options": "low\nmedium\nhigh\ncritical"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "open\nin_progress\nfulfilled\nclosed\ncancelled",
      "default": "open"
    },
    {
      "fieldname": "handling_mode",
      "label": "Handling Mode",
      "fieldtype": "Select",
      "options": "community\nposko",
      "default": "community",
      "reqd": 1
    },
    {
      "fieldname": "handling_posko",
      "label": "Handling Posko",
      "fieldtype": "Link",
      "options": "RN Posko"
    },
    {
      "fieldname": "takeover_status",
      "label": "Take Over Status",
      "fieldtype": "Select",
      "options": "none\npending\naccepted\nreleased",
      "default": "none",
      "reqd": 1
    },
    {
      "fieldname": "takeover_requested_at",
      "label": "Take Over Requested At",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "takeover_at",
      "label": "Taken Over At",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "takeover_by",
      "label": "Taken Over By",
      "fieldtype": "Link",
      "options": "RN User Account"
    },
    {
      "fieldname": "legacy_payload",
      "label": "Legacy Payload",
      "fieldtype": "Code",
      "options": "JSON"
    },
    {
      "fieldname": "verification_status",
      "label": "Verification Status",
      "fieldtype": "Data",
      "default": "unverified"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
