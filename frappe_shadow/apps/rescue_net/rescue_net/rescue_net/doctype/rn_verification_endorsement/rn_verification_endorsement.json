    { "fieldname": "visible_on_profile", "label": "Tampil di Profil Publik", "fieldtype": "Check", "default": "1" },
    { "fieldname": "verified_at", "label": "Diverifikasi Pada", "fieldtype": "Datetime" },
    { "fieldname": "expires_at", "label": "Kedaluwarsa Pada", "fieldtype": "Datetime" },
    { "fieldname": "revoked_at", "label": "Dicabut Pada", "fieldtype": "Datetime" },
    { "fieldname": "revoked_by", "label": "Dicabut Oleh", "fieldtype": "Data" },
    { "fieldname": "revoke_reason", "label": "Alasan Pencabutan", "fieldtype": "Small Text" }
