  },
  {
   "fieldname": "posted_at",
   "label": "Dikirim Pada",
   "fieldtype": "Datetime",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ]
}
