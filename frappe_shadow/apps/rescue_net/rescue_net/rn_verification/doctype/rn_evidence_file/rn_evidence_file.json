{
  "doctype": "DocType",
  "name": "RN Evidence File",
  "module": "RN Verification",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "field:legacy_id",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "fields": [
    {
      "fieldname": "legacy_id",
      "label": "Legacy ID",
      "fieldtype": "Data",
      "unique": 1
    },
    {
      "fieldname": "legacy_source",
      "label": "Legacy Source",
      "fieldtype": "Data",
      "default": "rescue-net-fastapi"
    },
    {
      "fieldname": "migration_status",
      "label": "Migration Status",
      "fieldtype": "Select",
      "options": "Shadow Imported\nValidated\nNeeds Review",
      "default": "Shadow Imported"
    },
    {
      "fieldname": "title",
      "label": "Filename",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "disaster_event",
      "label": "Disaster Event",
      "fieldtype": "Link",
      "options": "RN Disaster Event"
    },
    {
      "fieldname": "disaster_event_legacy_id",
      "label": "Disaster Event Legacy ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "posko",
      "label": "Posko",
      "fieldtype": "Link",
      "options": "RN Posko"
    },
    {
      "fieldname": "posko_legacy_id",
      "label": "Posko Legacy ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "linked_object_type",
      "label": "Linked Object Type",
      "fieldtype": "Data"
    },
    {
      "fieldname": "linked_object_id",
      "label": "Linked Object ID (legacy)",
      "fieldtype": "Data"
    },
    {
      "fieldname": "evidence_type",
      "label": "Evidence Type",
      "fieldtype": "Data"
    },
    {
      "fieldname": "filename",
      "label": "File Name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "file_path",
      "label": "Legacy File Path",
      "fieldtype": "Data"
    },
    {
      "fieldname": "mime_type",
      "label": "MIME Type",
      "fieldtype": "Data"
    },
    {
      "fieldname": "size_bytes",
      "label": "Size (bytes)",
      "fieldtype": "Int"
    },
    {
      "fieldname": "uploaded_by",
      "label": "Uploaded By (legacy)",
      "fieldtype": "Data"
    },
    {
      "fieldname": "verification_status",
      "label": "Verification Status",
      "fieldtype": "Data"
    },
    {
      "fieldname": "legacy_payload",
      "label": "Legacy Payload",
      "fieldtype": "Code",
      "options": "JSON"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ]
}
