{
  "doctype": "DocType",
  "name": "RN Disaster Event",
  "module": "Rescue Net",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "field:legacy_id",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "fields": [
    {
      "fieldname": "legacy_id",
      "label": "Legacy ID",
      "fieldtype": "Data",
      "unique": 1
    },
    {
      "fieldname": "legacy_source",
      "label": "Legacy Source",
      "fieldtype": "Data",
      "default": "rescue-net-fastapi"
    },
    {
      "fieldname": "migration_status",
      "label": "Migration Status",
      "fieldtype": "Select",
      "options": "Shadow Imported\nValidated\nNeeds Review",
      "default": "Shadow Imported"
    },
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "event_status",
      "label": "Status",
      "fieldtype": "Data"
    },
    {
      "fieldname": "severity",
      "label": "Severity",
      "fieldtype": "Data"
    },
    {
      "fieldname": "location_summary",
      "label": "Location Summary",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "started_at",
      "label": "Started At",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "legacy_payload",
      "label": "Legacy Payload",
      "fieldtype": "Code",
      "options": "JSON"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ]
}
