{
  "appId": "org.rescuenet.app",
  "appName": "Rescue-Net",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://rescue-net.online/rescue-net/index.html?source=app",
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "rescue-net.online"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#fff7f0",
      "showSpinner": false
    }
  }
}
