{
  "doctype": "DocType",
  "name": "RN Shelter Need",
  "module": "Rescue Net",
  "custom": 0,
  "is_submittable": 0,
  "title_field": "item_name",
  "fields": [
    {
      "fieldname": "legacy_id",
      "label": "Legacy ID",
      "fieldtype": "Data",
      "unique": 1
    },
    {
      "fieldname": "posko",
      "label": "Shelter / Posko",
      "fieldtype": "Link",
      "options": "RN Posko",
      "reqd": 1
    },
    {
      "fieldname": "item_name",
      "label": "Kebutuhan",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "quantity_mode",
      "label": "Mode Jumlah",
      "fieldtype": "Select",
      "options": "exact\nestimated\nrange\nunknown",
      "default": "unknown"
    },
    {
      "fieldname": "quantity_needed",
      "label": "Jumlah / Estimasi",
      "fieldtype": "Float"
    },
    {
      "fieldname": "quantity_min",
      "label": "Jumlah Minimum",
      "fieldtype": "Float"
    },
    {
      "fieldname": "quantity_max",
      "label": "Jumlah Maksimum",
      "fieldtype": "Float"
    },
    {
      "fieldname": "quantity_text",
      "label": "Keterangan Jumlah",
      "fieldtype": "Data"
    },
    {
      "fieldname": "unit",
      "label": "Satuan",
      "fieldtype": "Data"
    },
    {
      "fieldname": "priority",
      "label": "Prioritas",
      "fieldtype": "Select",
      "options": "normal\nurgent\ncritical",
      "default": "normal"
    },
    {
      "fieldname": "need_status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "open\npartially_met\nmet\ncancelled",
      "default": "open"
    },
    {
      "fieldname": "needed_before",
      "label": "Dibutuhkan Sebelum",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "notes",
      "label": "Catatan",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "observed_at",
      "label": "Observed At",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "verification_status",
      "label": "Verification Status",
      "fieldtype": "Data",
      "default": "self_reported"
    },
    {
      "fieldname": "created_by_user",
      "label": "Created By",
      "fieldtype": "Link",
      "options": "RN User Account"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
