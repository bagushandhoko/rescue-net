    {
      "fieldname": "booked_by_id",
      "label": "ID Pemesan",
      "fieldtype": "Data"
    },
    {
      "fieldname": "booker_name",
      "label": "Nama Pemesan",
      "fieldtype": "Data"
    },
    {
      "fieldname": "aid_offer",
      "label": "Aid Offer",
      "fieldtype": "Link",
      "options": "RN Aid Offer"
    },
    {
      "fieldname": "logistic_need",
      "label": "Logistic Need",
      "fieldtype": "Link",
      "options": "RN Logistic Need"
    },
    {
      "fieldname": "cargo_desc",
      "label": "Barang / Muatan",
      "fieldtype": "Data"
    },
    {
      "fieldname": "qty_weight_kg",
      "label": "Berat (kg)",
      "fieldtype": "Float"
    },
    {
      "fieldname": "qty_volume_m3",
      "label": "Volume (m3)",
      "fieldtype": "Float"
    },
    {
      "fieldname": "pickup_location",
      "label": "Lokasi Jemput",
      "fieldtype": "Data"
    },
    {
      "fieldname": "dropoff_location",
      "label": "Lokasi Antar",
      "fieldtype": "Data"
    },
    {
      "fieldname": "contact_person",
      "label": "Narahubung",
      "fieldtype": "Data"
    },
    {
      "fieldname": "contact_phone",
