{
  "doctype": "DocType",
  "name": "RN Aid Offer",
  "module": "Rescue Net",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "field:legacy_id",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "fields": [
    {
      "fieldname": "legacy_id",
      "label": "Legacy ID",
      "fieldtype": "Data",
      "unique": 1
    },
    {
      "fieldname": "legacy_source",
      "label": "Legacy Source",
      "fieldtype": "Data",
      "default": "rescue-net-fastapi"
    },
    {
      "fieldname": "migration_status",
      "label": "Migration Status",
      "fieldtype": "Select",
      "options": "Shadow Imported\nValidated\nNeeds Review",
      "default": "Shadow Imported"
    },
    {
      "fieldname": "title",
      "label": "Aid Offer Title",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "disaster_event",
      "label": "Disaster Event",
      "fieldtype": "Link",
      "options": "RN Disaster Event"
    },
    {
      "fieldname": "donor_name",
      "label": "Donor Name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "item_name",
      "label": "Item Name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "quantity",
      "label": "Quantity",
      "fieldtype": "Float"
    },
    {
      "fieldname": "unit",
      "label": "Unit",
      "fieldtype": "Data"
    },
    {
      "fieldname": "offer_status",
      "label": "Offer Status",
      "fieldtype": "Data"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ]
}
