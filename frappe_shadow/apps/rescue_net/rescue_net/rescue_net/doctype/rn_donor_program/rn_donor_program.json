{
  "doctype": "DocType",
  "name": "RN Donor Program",
  "module": "Rescue Net",
  "engine": "InnoDB",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "disaster_event",
    "program_name",
    "program_type",
    "owner_type",
    "owner_id",
    "target_description",
    "target_amount",
    "target_unit",
    "current_amount",
    "status",
    "location",
    "contact_person",
    "contact_phone",
    "public_visibility",
    "created_by_user",
    "observed_at",
    "notes"
  ],
  "fields": [
    {
      "fieldname": "disaster_event",
      "fieldtype": "Data",
      "label": "Disaster Event",
      "reqd": 1
    },
    {
      "fieldname": "program_name",
      "fieldtype": "Data",
      "label": "Program Name",
      "reqd": 1
    },
    {
      "fieldname": "program_type",
      "fieldtype": "Data",
      "label": "Program Type",
      "default": "general_relief"
    },
    {
      "fieldname": "owner_type",
      "fieldtype": "Select",
      "label": "Owner Type",
      "options": "organization\nposko\ncommunity_group",
      "default": "organization"
    },
    {
      "fieldname": "owner_id",
      "fieldtype": "Data",
      "label": "Owner ID"
    },
    {
      "fieldname": "target_description",
      "fieldtype": "Small Text",
      "label": "Target Description"
    },
    {
      "fieldname": "target_amount",
      "fieldtype": "Float",
      "label": "Target Amount",
      "default": "0"
    },
    {
      "fieldname": "target_unit",
      "fieldtype": "Data",
      "label": "Target Unit",
      "default": "IDR"
    },
    {
      "fieldname": "current_amount",
      "fieldtype": "Float",
      "label": "Current Amount",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "active\ncompleted\ncancelled",
      "default": "active"
    },
    {
      "fieldname": "location",
      "fieldtype": "Data",
      "label": "Location"
    },
    {
      "fieldname": "contact_person",
      "fieldtype": "Data",
      "label": "Contact Person"
    },
    {
      "fieldname": "contact_phone",
      "fieldtype": "Data",
      "label": "Contact Phone"
    },
    {
      "fieldname": "public_visibility",
      "fieldtype": "Select",
      "label": "Public Visibility",
      "options": "summary_public\ninternal\nrestricted",
      "default": "summary_public"
    },
    {
      "fieldname": "created_by_user",
      "fieldtype": "Data",
      "label": "Created By User",
      "read_only": 1
    },
    {
      "fieldname": "observed_at",
      "fieldtype": "Datetime",
      "label": "Observed At",
      "read_only": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
