{
  "doctype": "DocType",
  "name": "RN Community Feedback",
  "module": "Rescue Net",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "hash",
  "title_field": "topic",
  "fields": [
    { "fieldname": "legacy_id", "label": "Legacy ID", "fieldtype": "Data" },
    { "fieldname": "disaster_event", "label": "Disaster Event", "fieldtype": "Link", "options": "RN Disaster Event" },
    { "fieldname": "disaster_event_legacy_id", "label": "Disaster Event Legacy ID", "fieldtype": "Data" },
    { "fieldname": "topic", "label": "Topik", "fieldtype": "Data", "in_list_view": 1, "reqd": 1 },
    { "fieldname": "category", "label": "Kategori", "fieldtype": "Select",
      "options": "usul\nkeluhan\ninformasi\npertanyaan", "default": "usul", "in_list_view": 1 },
    { "fieldname": "author_name", "label": "Nama", "fieldtype": "Data", "in_list_view": 1 },
    { "fieldname": "author_contact", "label": "Kontak (opsional)", "fieldtype": "Data" },
    { "fieldname": "author_user", "label": "User Account", "fieldtype": "Link", "options": "RN User Account" },
    { "fieldname": "body", "label": "Isi", "fieldtype": "Text", "reqd": 1 },
    { "fieldname": "parent_feedback", "label": "Balasan Untuk", "fieldtype": "Link", "options": "RN Community Feedback" },
    { "fieldname": "wilayah", "label": "Wilayah", "fieldtype": "Data" },
    { "fieldname": "upvotes", "label": "Dukungan", "fieldtype": "Int", "default": "0" },
    { "fieldname": "status", "label": "Status", "fieldtype": "Select",
      "options": "open\nnoted\nresolved\nhidden", "default": "open", "in_list_view": 1 },
    { "fieldname": "official_response", "label": "Tanggapan Resmi", "fieldtype": "Small Text" },
    { "fieldname": "responded_by", "label": "Ditanggapi Oleh", "fieldtype": "Data" },
    { "fieldname": "responded_at", "label": "Ditanggapi Pada", "fieldtype": "Datetime" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1 }
  ]
}
