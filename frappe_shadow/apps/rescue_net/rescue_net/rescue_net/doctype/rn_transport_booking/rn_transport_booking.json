      "read_only": 1
    },
    {
      "fieldname": "reject_reason",
      "label": "Alasan Ditolak",
      "fieldtype": "Data"
    },
    {
      "fieldname": "requested_at",
      "label": "Diminta",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "confirmed_at",
      "label": "Dikonfirmasi",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "notes",
      "label": "Catatan",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "created_by_user",
      "label": "Created By",
      "fieldtype": "Link",
      "options": "RN User Account"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
