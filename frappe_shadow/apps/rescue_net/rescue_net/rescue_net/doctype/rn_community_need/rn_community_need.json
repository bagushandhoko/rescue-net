{
  "doctype": "DocType",
  "name": "RN Community Need",
  "module": "Rescue Net",
  "custom": 0,
  "is_submittable": 0,
  "title_field": "title",
  "fields": [
    {
      "fieldname": "legacy_id",
      "label": "Legacy ID",
