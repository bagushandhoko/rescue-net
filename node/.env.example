# Salin menjadi .env (pasang.sh membuatnya otomatis bila belum ada). JANGAN commit .env.
RN_PROJECT=rescuenet
# nama situs Frappe (produksi lama: osiun.localhost — pertahankan saat memindah data lama)
RN_SITE=osiun.localhost
# domain publik (untuk tautan, cookie, login Google)
RN_DOMAIN=rescue-net.online
# pintu web: 127.0.0.1 = hanya lewat tunnel/proxy di mesin ini; 0.0.0.0 = terbuka di jaringan lokal
RN_WEB_BIND=127.0.0.1
RN_WEB_PORT=8182
# diisi otomatis oleh pasang.sh (acak) bila kosong
RN_DB_ROOT_PASSWORD=
RN_ADMIN_PASSWORD=
# penyetelan: kosong = dihitung otomatis dari CPU/RAM mesin
RN_WORKERS=
# jumlah proses pekerja tugas latar (profil jobs)
RN_JOB_WORKERS=1
RN_DB_BUFFER=
# token Cloudflare Tunnel (opsional)
RN_CF_TUNNEL_TOKEN=
