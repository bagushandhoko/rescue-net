{
  "doctype": "DocType",
  "name": "RN Procurement Tender",
  "module": "RN Logistics",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "hash",
  "title_field": "title",
  "fields": [
    { "fieldname": "legacy_id", "label": "Legacy ID", "fieldtype": "Data" },
    { "fieldname": "title", "label": "Judul Pekerjaan", "fieldtype": "Data", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "tender_category", "label": "Jenis Pengadaan", "fieldtype": "Select", "options": "\nconstruction\ngoods\nservices\nconsultancy" },
    { "fieldname": "funding_source", "label": "Sumber Dana", "fieldtype": "Data" },
    { "fieldname": "disaster_event", "label": "Disaster Event", "fieldtype": "Link", "options": "RN Disaster Event" },
    { "fieldname": "disaster_event_legacy_id", "label": "Disaster Event Legacy ID", "fieldtype": "Data" },
    { "fieldname": "donor_program", "label": "Program Donasi", "fieldtype": "Link", "options": "RN Donor Program" },
    { "fieldname": "organization", "label": "Organisasi Penyelenggara", "fieldtype": "Link", "options": "RN Organization" },
    { "fieldname": "scope_description", "label": "Lingkup Pekerjaan", "fieldtype": "Text" },
    { "fieldname": "location", "label": "Lokasi", "fieldtype": "Data", "in_list_view": 1 },
    { "fieldname": "rab_total", "label": "Nilai RAB / HPS (Rp)", "fieldtype": "Float", "in_list_view": 1 },
    { "fieldname": "rab_document_url", "label": "Dokumen RAB / B&Q (URL)", "fieldtype": "Data" },
    { "fieldname": "design_image_url", "label": "Gambar Desain (URL)", "fieldtype": "Data", "description": "Sketsa/gambar desain pekerjaan yang ditenderkan (denah, ilustrasi, atau foto rencana bangunan)." },
    { "fieldname": "work_drawings", "label": "Gambar Kerja & Dokumen (JSON)", "fieldtype": "Long Text", "description": "Diisi lewat unggahan (gambar kerja + halaman RAB)." },
    { "fieldname": "bidding_opens_at", "label": "Buka Penawaran", "fieldtype": "Datetime" },
    { "fieldname": "bidding_closes_at", "label": "Batas Akhir Penawaran", "fieldtype": "Datetime", "in_list_view": 1 },
    { "fieldname": "explanation_schedule", "label": "Rapat Penjelasan / Peninjauan Lapangan", "fieldtype": "Small Text" },
    { "fieldname": "work_start_date", "label": "Rencana Mulai Kerja", "fieldtype": "Date" },
    { "fieldname": "target_completion_date", "label": "Target Selesai Kerja", "fieldtype": "Date" },
    { "fieldname": "work_duration_days", "label": "Masa Pelaksanaan (hari kalender)", "fieldtype": "Int" },
    { "fieldname": "maintenance_days", "label": "Masa Pemeliharaan (hari)", "fieldtype": "Int" },
    { "fieldname": "bidder_requirements", "label": "Syarat Peserta Tender", "fieldtype": "Text" },
    { "fieldname": "required_documents", "label": "Dokumen Penawaran yang Wajib Dilampirkan", "fieldtype": "Text" },
    { "fieldname": "bid_submission_email", "label": "Email Pengiriman Penawaran", "fieldtype": "Data", "options": "Email" },
    { "fieldname": "evaluation_method", "label": "Metode Evaluasi", "fieldtype": "Select", "options": "\nlowest_price\nquality_price\nquality" },
    { "fieldname": "bid_validity_days", "label": "Masa Berlaku Penawaran (hari)", "fieldtype": "Int" },
    { "fieldname": "payment_terms", "label": "Cara Pembayaran", "fieldtype": "Small Text" },
    { "fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "draft\nopen\nevaluation\nawarded\ncancelled", "default": "draft", "in_list_view": 1 },
    { "fieldname": "awarded_bid", "label": "Penawaran Pemenang", "fieldtype": "Link", "options": "RN Tender Bid" },
    { "fieldname": "contact_person", "label": "Narahubung", "fieldtype": "Data" },
    { "fieldname": "contact_phone", "label": "Kontak", "fieldtype": "Data" },
    { "fieldname": "notes", "label": "Catatan", "fieldtype": "Small Text" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1 }
  ]
}
