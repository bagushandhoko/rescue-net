{
  "doctype": "DocType",
  "name": "RN Action Plan",
  "module": "RN Command",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "field:legacy_id",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "fields": [
    {
      "fieldname": "legacy_id",
      "label": "Legacy ID",
      "fieldtype": "Data",
      "unique": 1
    },
    {
      "fieldname": "legacy_source",
      "label": "Legacy Source",
      "fieldtype": "Data",
      "default": "rescue-net-fastapi"
    },
    {
      "fieldname": "migration_status",
      "label": "Migration Status",
      "fieldtype": "Select",
      "options": "Shadow Imported\nValidated\nNeeds Review",
      "default": "Shadow Imported"
    },
    {
      "fieldname": "title",
      "label": "Action Title",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "disaster_event",
      "label": "Disaster Event",
      "fieldtype": "Link",
      "options": "RN Disaster Event"
    },
    {
      "fieldname": "disaster_event_legacy_id",
      "label": "Disaster Event Legacy ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "posko",
      "label": "Posko",
      "fieldtype": "Link",
      "options": "RN Posko"
    },
    {
      "fieldname": "posko_legacy_id",
      "label": "Posko Legacy ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Data"
    },
    {
      "fieldname": "target_object",
      "label": "Target Object",
      "fieldtype": "Data"
    },
    {
      "fieldname": "target_quantity",
      "label": "Target Quantity",
      "fieldtype": "Float"
    },
    {
      "fieldname": "target_unit",
      "label": "Target Unit",
      "fieldtype": "Data"
    },
    {
      "fieldname": "assigned_to",
      "label": "Assigned To (legacy)",
      "fieldtype": "Data"
    },
    {
      "fieldname": "planned_start",
      "label": "Planned Start",
      "fieldtype": "Data"
    },
    {
      "fieldname": "planned_end",
      "label": "Planned End",
      "fieldtype": "Data"
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Data"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Data"
    },
    {
      "fieldname": "notes",
      "label": "Notes",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "legacy_payload",
      "label": "Legacy Payload",
      "fieldtype": "Code",
      "options": "JSON"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ]
}
