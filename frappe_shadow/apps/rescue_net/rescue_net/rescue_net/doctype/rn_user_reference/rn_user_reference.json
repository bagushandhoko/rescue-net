   "fieldtype": "Data"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "pending\ncontacted\nconfirmed\ndeclined\nunreachable",
   "default": "pending",
   "in_list_view": 1
  },
  {
   "fieldname": "notes",
   "label": "Catatan",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "decided_by",
   "label": "Decided By",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "decided_at",
   "label": "Decided At",
