{
  "doctype": "DocType",
  "name": "RN Tender Bid",
  "module": "Rescue Net",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "hash",
  "title_field": "bidder_name",
  "fields": [
    { "fieldname": "legacy_id", "label": "Legacy ID", "fieldtype": "Data" },
    { "fieldname": "tender", "label": "Tender", "fieldtype": "Link", "options": "RN Procurement Tender", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "bidder_name", "label": "Nama Penawar", "fieldtype": "Data", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "bidder_org", "label": "Perusahaan / Organisasi", "fieldtype": "Data" },
    { "fieldname": "bidder_contact", "label": "Kontak", "fieldtype": "Data" },
    { "fieldname": "bidder_user", "label": "User Account", "fieldtype": "Link", "options": "RN User Account" },
    { "fieldname": "bid_amount", "label": "Nilai Penawaran (Rp)", "fieldtype": "Float", "in_list_view": 1 },
    { "fieldname": "bid_days", "label": "Waktu Pengerjaan (hari)", "fieldtype": "Int" },
    { "fieldname": "proposal_summary", "label": "Ringkasan Proposal", "fieldtype": "Small Text" },
    { "fieldname": "attachment_url", "label": "Lampiran (URL)", "fieldtype": "Data" },
    { "fieldname": "status", "label": "Status", "fieldtype": "Select",
      "options": "submitted\nshortlisted\nrejected\nawarded", "default": "submitted", "in_list_view": 1 },
    { "fieldname": "submitted_at", "label": "Waktu Kirim", "fieldtype": "Datetime" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1 }
  ]
}
