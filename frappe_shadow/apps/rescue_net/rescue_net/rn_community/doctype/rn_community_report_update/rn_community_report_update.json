{
 "doctype": "DocType",
 "name": "RN Community Report Update",
 "module": "RN Community",
 "custom": 0,
 "is_submittable": 0,
 "autoname": "hash",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "report",
   "label": "Laporan",
   "fieldtype": "Link",
   "options": "RN Community Report",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "update_type",
   "label": "Jenis",
   "fieldtype": "Select",
   "options": "info\nadditional_need\nresolved",
   "default": "info",
   "in_list_view": 1
  },
  {
   "fieldname": "body",
   "label": "Isi Tindak Lanjut",
   "fieldtype": "Small Text",
   "reqd": 1
  },
  {
   "fieldname": "urgent_needs",
   "label": "Kebutuhan Tambahan",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "affected_people_count",
   "label": "Jumlah Terdampak (terbaru)",
   "fieldtype": "Int",
   "non_negative": 1
  },
  {
   "fieldname": "author_user",
   "label": "Penulis",
   "fieldtype": "Link",
   "options": "RN User Account",
   "read_only": 1
  },
  {
   "fieldname": "author_role",
