{
  "doctype": "DocType",
  "name": "RN Volunteer Accommodation",
  "module": "Rescue Net",
  "custom": 0,
  "is_submittable": 0,
  "title_field": "location_name",
  "fields": [
    {
      "fieldname": "legacy_id",
      "label": "Legacy ID",
      "fieldtype": "Data",
      "unique": 1
    },
    {
      "fieldname": "disaster_event",
      "label": "Disaster Event",
      "fieldtype": "Link",
      "options": "RN Disaster Event",
      "reqd": 1
    },
    {
      "fieldname": "posko",
      "label": "Posko Koordinasi",
      "fieldtype": "Link",
      "options": "RN Posko"
    },
    {
      "fieldname": "location_name",
      "label": "Nama Lokasi",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "accommodation_type",
      "label": "Jenis Akomodasi",
      "fieldtype": "Select",
      "options": "mess\nrumah_singgah\ntenda\nhotel\nlainnya",
      "default": "mess"
    },
    {
      "fieldname": "capacity_beds",
      "label": "Kapasitas Tempat Tidur",
      "fieldtype": "Int"
    },
    {
      "fieldname": "occupants_count",
      "label": "Relawan/Petugas Menginap",
      "fieldtype": "Int"
    },
    {
      "fieldname": "is_safe_point",
      "label": "Titik Aman",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "safety_status",
      "label": "Status Keselamatan",
      "fieldtype": "Select",
      "options": "aman\nperlu_perhatian\ndarurat",
      "default": "aman"
    },
    {
      "fieldname": "notes",
      "label": "Catatan",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "observed_at",
      "label": "Observed At",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "verification_status",
      "label": "Verification Status",
      "fieldtype": "Data",
      "default": "self_reported"
    },
    {
      "fieldname": "created_by_user",
      "label": "Created By",
      "fieldtype": "Link",
      "options": "RN User Account"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
