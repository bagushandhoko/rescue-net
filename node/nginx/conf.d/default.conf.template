# Public front door for ${RN_DOMAIN} (Cloudflare Tunnel -> 127.0.0.1:8182).
# Serves ONLY the website files and a whitelist of Frappe endpoints. Everything else is 404:
# Desk (/app), /api/resource, /login, files, repo content (.git, docs, scripts, ...).

# real visitor IP: cloudflared reaches us from the docker gateway; Cloudflare puts the visitor in CF-Connecting-IP
map $http_cf_connecting_ip $client_ip { default $http_cf_connecting_ip; "" $remote_addr; }
limit_req_zone $client_ip zone=rn_login:10m rate=10r/m;
limit_req_zone $client_ip zone=rn_api:10m rate=600r/m;

# guest micro-cache (uji beban S10, 2026-10-26): public feeds identical for every guest -> 20 s copy.
# A request carrying a real session cookie (sid other than Guest) always goes to Frappe and is never stored.
proxy_cache_path /var/cache/nginx/rn levels=1:2 keys_zone=rn_guest:10m max_size=200m inactive=10m use_temp_path=off;
map $cookie_sid $rn_is_user { default 1; "" 0; "Guest" 0; }

# www -> apex: the Frappe site host_name (Google OAuth callback, session cookie) is ${RN_DOMAIN}.
server {
    listen 80;
    server_name www.${RN_DOMAIN};
    return 301 https://${RN_DOMAIN}$request_uri;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    absolute_redirect off;
    resolver 127.0.0.11 valid=10s ipv6=off;   # docker DNS: follow a restarted backend
    client_max_body_size 10m;

    set $rn_backend http://backend:8000;   # server-level: a location's `rewrite ... break` would skip a later `set`

    root /repo;                               # whole checkout mounted read-only; only the locations below are reachable

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ---- hard denies (regex locations beat plain prefix locations) ----
    location ~* (^|/)(\.|@eaDir)                                   { return 404; }
    location ~* \.(zip|tgz|gz|sql|dump|log|map|py|pyc|sh|env|yml|yaml|orig|old|swp)$ { return 404; }
    location ~* \.(bak|pre)[-_.0-9a-z]*$                           { return 404; }

    # ---- Frappe: whitelist only ----
    # guest-cached public feeds (must precede the generic API regex)
    location ~ ^/rescue-net-frappe/api/method/rescue_net\.api_(events\.disasters|ai\.public_active_disasters|ai\.public_context|control_centre\.active_disasters_board|control_centre\.public_dashboard|early_warning\.banner|public_needs\.board|frontend_bridge\.community_reports)$ {
        limit_req zone=rn_api burst=60 nodelay;
        rewrite ^/rescue-net-frappe/(.*)$ /$1 break;
        include /etc/nginx/rn-proxy.conf;
        proxy_cache rn_guest;
        proxy_cache_methods GET HEAD;
        proxy_cache_key "$uri?$args";
        proxy_cache_bypass $rn_is_user;
        proxy_no_cache $rn_is_user;
        proxy_cache_valid 200 20s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_use_stale updating error timeout http_502 http_503;
        proxy_cache_background_update on;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_hide_header Set-Cookie;
        add_header X-RN-Cache $upstream_cache_status always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
    # website API: rescue_net.api_<module>.<function>
    location ~ ^/rescue-net-frappe/api/method/rescue_net\.api_[a-z0-9_]+\.[A-Za-z0-9_]+$ {
        limit_req zone=rn_api burst=60 nodelay;
        rewrite ^/rescue-net-frappe/(.*)$ /$1 break;
        include /etc/nginx/rn-proxy.conf;
    }
    location = /rescue-net-frappe/api/method/login {
        limit_req zone=rn_login burst=5 nodelay;
        rewrite ^/rescue-net-frappe/(.*)$ /$1 break;
        include /etc/nginx/rn-proxy.conf;
    }
    location = /rescue-net-frappe/api/method/logout {
        rewrite ^/rescue-net-frappe/(.*)$ /$1 break;
        include /etc/nginx/rn-proxy.conf;
    }
    # Google OAuth callback (Frappe builds redirect_uri from host_name at the domain root)
    location = /api/method/frappe.integrations.oauth2_logins.login_via_google {
        limit_req zone=rn_login burst=5 nodelay;
        include /etc/nginx/rn-proxy.conf;
    }

    # ---- website (kept under /rescue-net/ because manifest + service worker scope use it) ----
    location = / { return 302 /rescue-net/; }
    location = /rescue-net { return 301 /rescue-net/; }
    location = /rescue-net/ { rewrite ^ /rescue-net/index.html last; }

    location = /rescue-net/index.html {
        alias /repo/index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /rescue-net/sw.js {
        alias /repo/sw.js;
        default_type application/javascript;
        add_header Cache-Control "no-cache" always;
        add_header Service-Worker-Allowed "/rescue-net/" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /rescue-net/manifest.webmanifest {
        alias /repo/manifest.webmanifest;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location /rescue-net/pages/ {
        alias /repo/pages/;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location /rescue-net/assets/ {
        alias /repo/assets/;
        add_header Cache-Control "public, max-age=3600" always;   # pages version assets with ?v=
        add_header X-Content-Type-Options nosniff always;
    }

    # everything else
    location / { return 404; }
}
